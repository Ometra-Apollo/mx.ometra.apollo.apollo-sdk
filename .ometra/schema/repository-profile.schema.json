{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ometra.mx/schemas/ometra-repository-profile.json",
  "title": "Ometra repository profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["repository", "standardsVersion", "governance", "stacks", "runtimes", "commands", "documentation", "owners", "exceptions"],
  "properties": {
    "$schema": { "type": "string" },
    "repository": { "type": "string", "minLength": 1 },
    "standardsVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adoptionStage", "stableBranch", "integrationBranch", "standardsRepository", "standardsRef"],
      "properties": {
        "adoptionStage": { "enum": ["observe", "warn", "enforce"] },
        "stableBranch": { "const": "main" },
        "integrationBranch": { "const": "dev" },
        "standardsRepository": { "type": "string", "minLength": 1 },
        "standardsRef": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "stacks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["php-laravel", "typescript-react", "node", "python", "go", "shell", "ai-prompts", "documentation"] }
    },
    "runtimes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "php": { "type": "string" },
        "node": { "type": "string" },
        "python": { "type": "string" },
        "go": { "type": "string" }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formatCheck", "lint", "test"],
      "properties": {
        "formatCheck": { "type": "string", "minLength": 1 },
        "lint": { "type": "string", "minLength": 1 },
        "typecheck": { "type": "string", "minLength": 1 },
        "test": { "type": "string", "minLength": 1 },
        "build": { "type": "string", "minLength": 1 }
      }
    },
    "documentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "sourceLocale", "locales"],
      "properties": {
        "manifest": { "type": "string", "minLength": 1 },
        "sourceLocale": { "const": "es" },
        "locales": { "type": "array", "contains": { "const": "es" }, "minItems": 1, "uniqueItems": true }
      }
    },
    "owners": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "coverageThreshold": { "type": "number", "minimum": 0, "maximum": 100 },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule", "scope", "reason", "risk", "compensatingControl", "ticket", "owner", "approvedBy", "created", "expires"],
        "properties": {
          "rule": { "type": "string", "minLength": 1 },
          "scope": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "risk": { "type": "string", "minLength": 1 },
          "compensatingControl": { "type": "string", "minLength": 1 },
          "ticket": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "approvedBy": { "type": "string", "minLength": 1 },
          "created": { "type": "string", "format": "date" },
          "expires": { "type": "string", "format": "date" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "stacks": { "contains": { "const": "php-laravel" } } },
        "required": ["stacks"]
      },
      "then": {
        "properties": {
          "runtimes": {
            "required": ["php"],
            "properties": { "php": { "const": "8.5" } }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stacks": {
            "contains": { "enum": ["typescript-react", "node"] }
          }
        },
        "required": ["stacks"]
      },
      "then": {
        "properties": {
          "runtimes": {
            "required": ["node"],
            "properties": { "node": { "const": "24" } }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "stacks": { "contains": { "const": "typescript-react" } } },
        "required": ["stacks"]
      },
      "then": {
        "properties": {
          "commands": { "required": ["formatCheck", "lint", "typecheck", "test", "build"] }
        }
      }
    },
    {
      "if": {
        "properties": { "stacks": { "contains": { "const": "go" } } },
        "required": ["stacks"]
      },
      "then": {
        "properties": { "commands": { "required": ["build"] } }
      }
    }
  ]
}
