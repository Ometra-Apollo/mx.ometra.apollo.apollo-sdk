#!/usr/bin/env php
<?php

declare(strict_types=1);

use Ometra\Caronte\Support\GroupSessionConfigException;
use Ometra\Caronte\Support\GroupSessionConfigValidator;

$autoloadCandidates = array_filter([
    getenv('APOLLO_CARONTE_AUTOLOAD') ?: null,
    __DIR__.'/../vendor/autoload.php',
    __DIR__.'/../../../autoload.php',
]);

foreach ($autoloadCandidates as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        if (class_exists(GroupSessionConfigValidator::class)) {
            break;
        }
    }
}

if (! class_exists(GroupSessionConfigValidator::class)) {
    fwrite(STDERR, "ERROR: Caronte SDK does not provide the group session validator.\n");
    exit(2);
}

try {
    $options = getopt('', ['workspace:', 'environment:', 'help']);
    if (isset($options['help'])) {
        fwrite(STDOUT, "Usage: validate-apollo-session-config [--workspace <directory>] [--environment dev|staging|prod]\n");
        exit(0);
    }

    $workspace = $options['workspace'] ?? getenv('APOLLO_WORKSPACE') ?: null;
    if ($workspace !== null && ! is_string($workspace)) {
        throw new GroupSessionConfigException('The --workspace option must be provided once.');
    }

    if ($workspace === null) {
        $current = getcwd();
        if ($current === false) {
            throw new GroupSessionConfigException('The current working directory cannot be resolved.');
        }

        if (is_dir($current.'/mx.ometra.apollo.aeris')) {
            $workspace = $current;
        } elseif (str_starts_with(basename($current), 'mx.ometra.apollo.')) {
            $workspace = dirname($current);
        } else {
            throw new GroupSessionConfigException('Apollo workspace cannot be detected; use --workspace.');
        }
    }

    $environment = $options['environment'] ?? 'prod';
    if (! is_string($environment) || ! in_array($environment, ['dev', 'staging', 'prod'], true)) {
        throw new GroupSessionConfigException('The environment must be dev, staging or prod.');
    }
    $presetPath = __DIR__.'/../config/group-session-config.json';
    $temporaryPreset = null;
    if ($environment !== 'prod') {
        $preset = json_decode((string) file_get_contents($presetPath), true, flags: JSON_THROW_ON_ERROR);
        $suffix = $environment === 'dev' ? 'dev' : 'staging';
        foreach ($preset['applications'] as &$application) {
            $application['env_files'] = ['.env.d/04-session.env', '.env.d/09-caronte.env', '.env.d/01-app.env'];
            if ($environment === 'dev') {
                array_push($application['env_files'], '.env.d/01-app.env.dev', '.env.d/04-session.env.dev', '.env.d/09-caronte.env.dev');
            }
            $application['env_files'][] = ".env.d/99-suite.env.{$suffix}";
        }
        unset($application);
        $cookie = $environment.'-apollo-session';
        foreach ($preset['rules'] as &$rule) {
            if (in_array($rule['key'], ['SESSION_COOKIE', 'CARONTE_SESSION_KEY'], true)) {
                $rule['value'] = $cookie;
            }
        }
        unset($rule);
        $temporaryPreset = tempnam(sys_get_temp_dir(), 'apollo-session-preset-');
        if ($temporaryPreset === false || file_put_contents($temporaryPreset, json_encode($preset, JSON_THROW_ON_ERROR)) === false) {
            throw new GroupSessionConfigException('Unable to prepare the environment preset.');
        }
        $presetPath = $temporaryPreset;
    }
    try {
        $result = (new GroupSessionConfigValidator)->validate($presetPath, $workspace);
    } finally {
        if ($temporaryPreset !== null) {
            @unlink($temporaryPreset);
        }
    }

    if (! $result->isValid()) {
        foreach ($result->violations as $violation) {
            fwrite(STDERR, 'ERROR: '.$violation."\n");
        }
        exit(1);
    }

    fwrite(STDOUT, sprintf(
        "Apollo shared-session configuration is consistent across %d applications.\n",
        $result->applicationCount,
    ));
    exit(0);
} catch (GroupSessionConfigException $exception) {
    fwrite(STDERR, 'ERROR: '.$exception->getMessage()."\n");
    exit(2);
} catch (Throwable $exception) {
    fwrite(STDERR, 'ERROR: Unexpected validator failure ('.$exception::class.").\n");
    exit(2);
}
